# Dayfold server settings (systemd EnvironmentFile or exported variables)
DAYFOLD_PORT=8422
DAYFOLD_HOST=0.0.0.0
# Data directory (database, editions). Default: ~/.local/share/dayfold
#DAYFOLD_DATA_DIR=/srv/dayfold
# Optional dashboard password. Without it, anyone on your network can open the dashboard.
#DAYFOLD_PASSWORD=change-me
# Language of the server's own text (API errors, labels, job logs) and of the newspaper on a
# fresh install: pt or en. Default: pt. After the first run the newspaper's language is a
# setting of its own in the dashboard.
#DAYFOLD_LANGUAGE=en
