<div class="section-head"><p class="kicker">{{ L.games }}</p><h1>{{ L.solutions }}</h1></div>
{% for g in games %}
<div class="game{% if not loop.first %} pb{% endif %}" id="s{{ g.index }}">
<h2>{{ g.title }}</h2>
{% if g.kind in ('sudoku', 'crossword') %}
<div class="puzzle-img"><img src="{{ g.solution_img }}" alt="{{ L.solutions }}"/></div>
{% elif g.kind == 'wordle' %}
<div class="tiles">{% for ch in g.solution.answer %}<span class="tile correct">{{ ch }}</span>{% endfor %}</div>
{% elif g.kind == 'wordsearch' %}
<table class="wordsearch">
{% for row in g.puzzle.rows %}{% set r = loop.index0 %}<tr>{% for ch in row %}<td{% if (r, loop.index0) in g.hits %} class="hit"{% endif %}>{{ ch }}</td>{% endfor %}</tr>
{% endfor %}
</table>
{% endif %}
<p class="back"><a href="{{ g.file }}">← {{ L.back }}</a></p>
</div>
{% endfor %}
