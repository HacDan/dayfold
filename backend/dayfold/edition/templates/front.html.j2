{% import "macros.j2" as m %}
<div class="masthead">
  <span class="ears">{{ ed.year_label }} · {{ ed.number_label }} · {{ L.daily }}</span>
  <h1 class="name">{{ ed.title }}</h1>
  {% if ed.tagline %}<p class="tagline">{{ ed.tagline }}</p>{% endif %}
</div>
<p class="dateline">{{ ed.long_date }}</p>
{% if weather %}
<p class="weather">{{ weather.place }} · {{ weather.condition }} · {{ L.high }} {{ weather.t_max }}{{ weather.unit }} · {{ L.low }} {{ weather.t_min }}{{ weather.unit }}<br/>{{ L.sunrise }} {{ weather.sunrise }} · {{ L.sunset }} {{ weather.sunset }}</p>
{% endif %}
{% if headline %}{{ m.article(headline, L, headline=True) }}{% endif %}
<div class="index">
  <h3>{{ L.in_this_edition }}</h3>
  {% for row in index %}
    <p class="sec"><a href="{{ row.href }}">{{ row.name }}</a></p>
    {% for it in row.links %}<p class="item"><a href="{{ it.href }}">{{ it.title }}</a></p>{% endfor %}
  {% endfor %}
  {% if has_charge %}<p class="sec"><a href="charge.xhtml">{{ L.charge }}</a></p>{% endif %}
  {% if games %}<p class="sec"><a href="{{ games[0].file }}">{{ L.games }}</a></p>
    {% for g in games %}<p class="item"><a href="{{ g.file }}">{{ g.title }}</a></p>{% endfor %}{% endif %}
</div>
