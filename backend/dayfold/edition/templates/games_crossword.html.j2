<div class="game">
{% if first %}<div class="section-head"><p class="kicker">{{ ed.title }}</p><h1>{{ L.games }}</h1></div>{% else %}<div class="pb"></div>{% endif %}
<h2>{{ g.title }}</h2>
<p class="help">{{ L.crossword_help }}</p>
<div class="puzzle-img crossword"><img src="{{ g.grid_img }}" alt="{{ g.title }}"/></div>
<div class="clues">
<p class="clues-head">{{ L.across }}</p>
{% for e in g.puzzle.across %}<p class="clue"><b>{{ e.n }}</b> {{ e.clue }} ({{ e.len }})</p>
{% endfor %}
<p class="clues-head">{{ L.down }}</p>
{% for e in g.puzzle.down %}<p class="clue"><b>{{ e.n }}</b> {{ e.clue }} ({{ e.len }})</p>
{% endfor %}
</div>
<p class="play"><a href="dayfold://game/{{ g.index }}">▶ {{ L.play_koreader }}</a></p>
<p class="back"><a href="solutions.xhtml#s{{ g.index }}">{{ L.see_solution }}</a></p>
</div>
