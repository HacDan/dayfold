<div class="game">
{% if first %}<div class="section-head"><p class="kicker">{{ ed.title }}</p><h1>{{ L.games }}</h1></div>{% endif %}
<h2>{{ g.title }}</h2>
<p class="help">{{ help }}</p>
<div class="tiles">{% for i in range(g.puzzle.length) %}<span class="tile absent">?</span>{% endfor %}</div>
{% if not native %}<p class="play"><a href="dayfold://game/{{ g.index }}">▶ {{ L.play_koreader }}</a></p>{% endif %}
<p class="meta">{{ L.wordle_pocket }}</p>
<table class="pocket">
{% for row in g.puzzle.pocket | batch(3) %}{% set r = loop.index0 %}<tr>{% for p in row %}<td><a href="wordle_{{ g.index }}_{{ r * 3 + loop.index0 }}.xhtml">{{ p.word }}</a></td>{% endfor %}</tr>
{% endfor %}
</table>
<p class="help">{{ L.wordle_legend }}</p>
<p class="back"><a href="solutions.xhtml#s{{ g.index }}">{{ L.see_solution }}</a></p>
</div>
